{
  "name": "luckysheet",
  "version": "2.1.13",
  "description": "Luckysheet is an online spreadsheet that is powerful, simple to configure, and completely open source.",
  "keywords": [
    "spreadsheet",
    "excel",
    "luckysheet",
    "table",
    "canvas"
  ],
  "homepage": "https://mengshukeji.gitee.io/LuckysheetDocs/",
  "bugs": {
    "url": "https://github.com/mengshukeji/Luckysheet/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mengshukeji/Luckysheet"
  },
  "license": "MIT",
  "author": "mengshukeji",
  "main": "dist/luckysheet.umd.js",
  "module": "dist/luckysheet.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/luckysheet.es.js",
      "require": "./dist/luckysheet.umd.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css",
    "*.less",
    "*.scss",
    "*.vue"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .js,.ts --fix",
    "lint:check": "eslint src --ext .js,.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "clipboard-polyfill": "^2.8.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "escape-html": "^1.0.3",
    "flatpickr": "^4.6.13",
    "html2canvas": "^1.4.1",
    "jquery-mousewheel": "^3.1.13",
    "jstat": "^1.9.6",
    "localforage": "^1.10.0",
    "numeral": "^2.0.6",
    "pako": "^2.1.0",
    "spectrum-colorpicker": "^1.8.1",
    "uuid": "^9.0.0"
  },
  "peerDependencies": {
    "jquery": ">=2.2.4"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "acorn": "^8.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.2.0",
    "jquery": "^3.7.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.7",
    "vuepress": "^1.9.10"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ]
}
